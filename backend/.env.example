# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/gofoodmern?retryWrites=true&w=majority

# Secret used to sign JWT auth tokens. Use a long, random string.
JWT_SECRET=change-this-to-a-long-random-secret

# OpenCage Geocoding API key (https://opencagedata.com/)
OPENCAGE_API_KEY=your-opencage-api-key

# Port the Express server listens on
PORT=5000

# Allowed origin for CORS (the frontend URL)
CLIENT_ORIGIN=http://localhost:3000
